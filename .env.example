# Адрес Sui, на который приходят ваши комиссии со свапов (ОБЯЗАТЕЛЬНО свой кошелёк)
NEXT_PUBLIC_FEE_RECEIVER=0x7211d7a33c32b8a848fd5d87dc0630b7d40d3d324856a748aff454c2955cab12
# Комиссия Voltswap: 0.001 = 0.1%
NEXT_PUBLIC_FEE_RATE=0.001
# RPC: браузер ходит на /api/sui (серверный прокси), он добавляет токен ноды.
# Задайте в Vercel: CHAINSTACK_SUI_TOKEN (секрет). Без него прокси использует публичную ноду.
# CHAINSTACK_SUI_TOKEN=
# SUI_GRPC_UPSTREAM=https://sui-mainnet.core.chainstack.com
# NEXT_PUBLIC_SUI_GRPC_URL=  # необязательно: прямой адрес в обход прокси
